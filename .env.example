# Copy to .env and fill in. .env is gitignored. Never commit a real key.

# Deployer key, hex, with or without 0x. Used only by the local forge scripts.
PRIVATE_KEY=

# RPC endpoints.
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org

# Etherscan API v2 key. Foundry uses it for BscScan on chain 56 and chain 97.
# A legacy BscScan-only key will not verify. Create a key at https://etherscan.io/apidashboard
BSCSCAN_API_KEY=

# BEP-20 bounty token.
# BSC mainnet Binance-Peg USDT (18 decimals): 0x55d398326f99059fF775485246999027B3197955
# BSC testnet: no single official Tether deployment. Common 18-decimal test USDT:
#   0x337610d27c682E347C9cD60BD4b3b107C9d34dDd
# Or deploy script/DeployMockUSDT.s.sol and paste that address. The mock reverts on mainnet.
USDT_ADDRESS=

# Agent ID registry.
# BSC mainnet, confirmed (SPACE ID docs + live eth_call): 0x60B9262456dE011F7d15a54CdD8c48bAaa8B022F
# BSC testnet: no registry was published. Deploy script/DeployMockRegistry.s.sol and paste it.
# Do not deploy the mock on mainnet. The script and the contract both refuse chain 56.
AGENT_ID_REGISTRY=

# Protocol fee in basis points. 0 disables it. 500 is the cap (5%), immutable after deploy.
FEE_BPS=0

# Receives the fee. Use the zero address only when FEE_BPS is 0.
# Cannot be changed later, and cannot be the market contract.
FEE_RECIPIENT=0x0000000000000000000000000000000000000000

# Minimum bounty in token base units. 10000000000000000 = 0.01 USDT when decimals are 18.
MIN_BOUNTY=10000000000000000

# Set to yes only for the mainnet deploy command. Not read on testnet.
CONFIRM_MAINNET=
